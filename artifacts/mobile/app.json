{
  "expo": {
    "name": "Navodaya Connect",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E40AF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.navodaya.connect"
    },
    "android": {
      "package": "com.navodaya.connect"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Navodaya Connect to access photos you choose to share.",
          "cameraPermission": "Allow Navodaya Connect to take photos you choose to share."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Navodaya Connect to scan Digital ID QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Navodaya Connect to save your Digital ID QR code.",
          "savePhotosPermission": "Allow Navodaya Connect to save your Digital ID QR code.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      "@maplibre/maplibre-react-native",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
